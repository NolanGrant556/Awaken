{
  "name": "@awaken/desktop",
  "productName": "Awaken",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm:watch:main\" \"npm:serve:renderer\" \"npm:launch:electron\"",
    "watch:main": "tsc -p tsconfig.node.json --watch --preserveWatchOutput",
    "serve:renderer": "vite --host 127.0.0.1 --port 5174",
    "launch:electron": "wait-on tcp:127.0.0.1:5174 file:dist/main/index.js && electron . --dev",
    "build": "npm run build:main && npm run build:renderer",
    "build:binary": "node ../../scripts/build-binary.mjs",
    "dist": "npm run build:binary && npm run build && electron-builder",
    "build:main": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "pretest": "npm --workspace @awaken/design-system run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@awaken/design-system": "0.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "electron": "42.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "wait-on": "^9.0.10"
  }
}
