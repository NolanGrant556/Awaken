{
  "servers": {
    "filesystem": {
      "stdio": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-filesystem", "/Users/me/Documents"],
        "env": {
          "NODE_NO_WARNINGS": "1"
        }
      }
    },
    "notion": {
      "http": {
        "url": "https://mcp.notion.com/mcp"
      }
    },
    "internal-echo": {
      "inProcess": {
        "serverName": "echo"
      }
    },
    "legacy-sse": {
      "sse": {
        "url": "https://internal.corp.example.com/mcp/sse"
      }
    }
  }
}
