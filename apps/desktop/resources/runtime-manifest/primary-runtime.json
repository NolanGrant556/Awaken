{
  "name": "primary-runtime",
  "version": "0.1.0",
  "mode": "hybrid",
  "components": [
    {
      "name": "python",
      "kind": "executable",
      "required": true,
      "path": "../runtime/python/bin/python3",
      "pathByPlatform": {
        "win32": "../runtime/python/Scripts/python.exe",
        "windows": "../runtime/python/Scripts/python.exe"
      }
    },
    {
      "name": "node",
      "kind": "executable",
      "required": true,
      "path": "../runtime/node/bin/node",
      "pathByPlatform": {
        "win32": "../runtime/node/node.exe",
        "windows": "../runtime/node/node.exe"
      }
    },
    {
      "name": "libreoffice",
      "kind": "application",
      "required": true,
      "path": "../runtime/libreoffice/LibreOffice.app",
      "pathByPlatform": {
        "win32": "../runtime/libreoffice",
        "windows": "../runtime/libreoffice"
      }
    },
    {
      "name": "poppler",
      "kind": "directory",
      "required": true,
      "path": "../runtime/poppler/bin"
    },
    {
      "name": "ffmpeg",
      "kind": "executable",
      "required": true,
      "path": "../runtime/ffmpeg/bin/ffmpeg",
      "pathByPlatform": {
        "win32": "../runtime/ffmpeg/bin/ffmpeg.exe",
        "windows": "../runtime/ffmpeg/bin/ffmpeg.exe"
      }
    },
    {
      "name": "helper-packages",
      "kind": "directory",
      "required": true,
      "path": "../runtime/packages"
    }
  ]
}
