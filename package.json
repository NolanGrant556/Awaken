{
  "name": "awaken",
  "private": true,
  "workspaces": [
    "Awaken Design System",
    "apps/*"
  ],
  "scripts": {
    "open:desktop": "node scripts/open-desktop.mjs",
    "close:desktop": "node scripts/close-desktop.mjs",
    "open:ui": "node scripts/open-ui.mjs",
    "dev:ui": "npm --workspace @awaken/design-system run dev",
    "build:ui": "npm --workspace @awaken/design-system run build",
    "typecheck:ui": "npm --workspace @awaken/design-system run typecheck",
    "smoke:ui": "npm --workspace @awaken/design-system run smoke:render",
    "predev:desktop": "npm run close:desktop",
    "dev:desktop": "npm run dev:desktop:managed",
    "dev:desktop:managed": "npm run build:ui && node scripts/ensure-desktop-runtime.mjs && npm --workspace @awaken/desktop run build:main && npm --workspace @awaken/desktop run dev",
    "build:desktop": "npm run build:ui && npm run build:binary && npm run prepare:officecli && npm --workspace @awaken/desktop run build",
    "dist:desktop": "node scripts/run-dist-desktop.mjs",
    "dist:desktop:adhoc": "npm run build:ui && npm --workspace @awaken/desktop run dist:adhoc",
    "dist:desktop:release": "npm run build:ui && npm --workspace @awaken/desktop run dist:release",
    "test:desktop-lifecycle": "node --test scripts/tests/desktop-lifecycle.test.mjs",
    "test:desktop-release": "node --test scripts/tests/desktop-release.test.mjs",
    "test:docs-links": "node --test scripts/tests/doc-links.test.mjs",
    "test:system-skills": "python3 -B -m unittest discover -s scripts/tests -p 'system_skills_*_test.py'",
    "test:mermaid-electron:contract": "node --test scripts/tests/mermaid-electron-regression.test.mjs",
    "test:mermaid-electron": "node scripts/mermaid-electron-regression.mjs",
    "build:binary": "node scripts/build-binary.mjs",
    "prepare:officecli": "node scripts/prepare-officecli.mjs",
    "check:docs-links": "node scripts/check-doc-links.mjs",
    "typecheck:desktop": "npm run build:ui && npm --workspace @awaken/desktop run typecheck",
    "capture:workbench": "node scripts/capture-workbench-acceptance.mjs",
    "capture:workbench:vrt": "node scripts/capture-workbench-vrt.mjs",
    "acceptance:desktop-hardening": "node scripts/accept-desktop-hardening.mjs"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.0",
    "yaml": "^2.9.0"
  }
}
