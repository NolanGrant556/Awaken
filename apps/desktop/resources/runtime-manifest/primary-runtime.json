{
  "schemaVersion": 2,
  "runtimeName": "primary-runtime",
  "bundleVersion": "0.3.0",
  "officeRenderWorker": {
    "component": "libreoffice",
    "defaultMaxConcurrency": 1,
    "defaultTimeoutSeconds": 90,
    "profileIsolation": "per-job",
    "outputCommit": "atomic",
    "macOSActivationPolicy": "background-only",
    "macOSBundleIdentifier": "com.awaken.runtime.libreoffice-renderer",
    "macOSLaunchServicesClaims": "none",
    "macOSReleaseNotarization": "required"
  },
  "distribution": {
    "development": "local-ad-hoc-revision",
    "release": "pre-signed-notarized-archive",
    "manifestDigest": "sha256",
    "install": "verify-then-atomic-activate",
    "signOnUserMachine": false
  },
  "components": [
    {
      "name": "python",
      "kind": "executable",
      "required": true,
      "version": "managed",
      "source": "awaken_managed",
      "relativePath": "python/bin/python3",
      "relativePathByPlatform": {
        "win32": "python/python.exe",
        "windows": "python/python.exe"
      },
      "probe": {
        "args": ["-c", "import pptx, PIL"],
        "acceptedExitCodes": [0]
      }
    },
    {
      "name": "node",
      "kind": "executable",
      "required": true,
      "version": "managed",
      "source": "awaken_managed",
      "relativePath": "node/bin/node",
      "relativePathByPlatform": {
        "win32": "node/node.exe",
        "windows": "node/node.exe"
      },
      "probe": {
        "args": ["--version"],
        "acceptedExitCodes": [0]
      }
    },
    {
      "name": "libreoffice",
      "kind": "application",
      "required": true,
      "version": "managed",
      "source": "awaken_managed",
      "relativePath": "libreoffice/LibreOffice.app",
      "relativePathByPlatform": {
        "win32": "libreoffice",
        "windows": "libreoffice",
        "linux": "libreoffice"
      },
      "probe": {
        "args": ["--version"],
        "acceptedExitCodes": [0],
        "executableRelativePath": "Contents/MacOS/soffice",
        "executableRelativePathByPlatform": {
          "win32": "program/soffice.com",
          "windows": "program/soffice.com",
          "linux": "program/soffice"
        }
      }
    },
    {
      "name": "poppler",
      "kind": "directory",
      "required": true,
      "version": "managed",
      "source": "awaken_managed",
      "relativePath": "poppler/bin",
      "probe": {
        "tools": ["pdftoppm", "pdfinfo"],
        "acceptedExitCodes": [0, 1]
      }
    },
    {
      "name": "ffmpeg",
      "kind": "executable",
      "required": true,
      "version": "managed",
      "source": "awaken_managed",
      "relativePath": "ffmpeg/bin/ffmpeg",
      "relativePathByPlatform": {
        "win32": "ffmpeg/bin/ffmpeg.exe",
        "windows": "ffmpeg/bin/ffmpeg.exe"
      },
      "probe": {
        "args": ["-version"],
        "acceptedExitCodes": [0]
      }
    },
    {
      "name": "helper-packages",
      "kind": "directory",
      "required": true,
      "version": "managed",
      "source": "awaken_managed",
      "relativePath": "packages",
      "probe": {
        "requireFile": "runtime.json"
      }
    }
  ]
}
