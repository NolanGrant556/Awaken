{
  "name": "@awaken/design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./index.css": "./dist/index.css",
    "./tokens/tokens.css": "./dist/tokens/tokens.css",
    "./tokens/components.css": "./dist/tokens/components.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build && npm run build:gallery-library && npm run build:types && npm run copy:assets",
    "build:gallery-library": "vite build --mode gallery-library",
    "build:gallery": "vite build --mode gallery",
    "build:types": "tsc -p tsconfig.build.json",
    "copy:assets": "node ../scripts/copy-design-system-assets.mjs",
    "preview": "npm run build:gallery && vite preview --host 127.0.0.1",
    "smoke:render": "npm run build && node smoke/render-smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.15.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.16"
  }
}
