# Environment variables
.env
.env.local
.env.*.local

# Go build artifacts
*.o
*.a
*.so
*.exe
*.dll

# Go test cache
_testmain.go

# Go module cache
go.sum

# Frontend/workspace dependencies and build artifacts
node_modules/
Awaken Design System/dist/
Awaken Design System/.vite/
Awaken Design System/*.tsbuildinfo
apps/*/node_modules/
apps/*/dist/
apps/*/dist-electron/
apps/*/.vite/
apps/*/*.tsbuildinfo

# IDE files
.vscode/
.idea/
.obsidian/
*.swp
*.swo
*~

# Test files with ignore directive
test-*.go

# CLI binary
/awaken
/awaken-core

# Desktop bundled awaken-core binaries
apps/desktop/resources/bin/

# macOS
.DS_Store

# Local Awaken runtime transcripts
.awaken/
# Product-owned metadata inside bundled Desktop plugins is release source, not
# local runtime state. Keep these narrow exceptions so clean clones receive the
# same packages that maintainers validate locally.
!apps/desktop/resources/builtin-plugins/*/.awaken/
!apps/desktop/resources/builtin-plugins/*/.awaken/builtin.json
!apps/desktop/resources/builtin-plugins/*/.awaken/setup.json

