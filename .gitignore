sourcecode/
.tmp-pr-export/
.codex/*
!.codex/skills/
.codex/skills/*
!.codex/skills/llm-provider-management/
.codex/skills/llm-provider-management/.obsidian/
.codex/skills/llm-provider-management/**/__pycache__/
.codex/skills/llm-provider-management/**/*.pyc
.claude/
CLAUDE.md
openspec/
.trae/
.trae/skills/
